<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:views="clr-namespace:MoonDiary.Views"
                     xmlns:c="clr-namespace:MoonDiary.Controls"
                     xmlns:p="clr-namespace:MoonDiary.Presentation;assembly=MoonDiary.Presentation"
                     xmlns:vm="clr-namespace:MoonDiary.Presentation.ViewModels;assembly=MoonDiary.Presentation"
                     x:Class="MoonDiary.Views.NewLetterPage"
                     x:DataType="vm:NewLetterViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpaceM}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Text="✕"
              Style="{StaticResource IconButton}"
              Command="{Binding CloseCommand}"
              SemanticProperties.Description="{x:Static p:Strings.Common_Close}"
              AutomationId="NewLetterCloseButton" />
      <Label Grid.Column="1" Text="{x:Static p:Strings.NewLetter_Title}" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
      <Button Grid.Column="2"
              Text="{x:Static p:Strings.NewLetter_Send}"
              Style="{StaticResource TextButton}"
              Command="{Binding SendCommand}"
              AutomationId="NewLetterSendButton" />
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}">
      <Grid RowDefinitions="*,Auto">
        <Editor Text="{Binding Text}"
                Placeholder="{x:Static p:Strings.NewLetter_Placeholder}"
                MaxLength="5000"
                AutomationId="NewLetterTextEditor" />
        <Label Grid.Row="1" Text="{Binding Counter}" Style="{StaticResource SecondaryLabel}" IsVisible="{Binding ShowCounter}" HorizontalTextAlignment="End" />
      </Grid>
    </Border>
    <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource SpaceS}">
      <Label Text="{x:Static p:Strings.NewLetter_Open}" Style="{StaticResource SecondaryLabel}" />
      <FlexLayout BindableLayout.ItemsSource="{Binding Presets}" Wrap="Wrap">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="vm:DayPresetViewModel">
            <c:ToggleButton Text="{Binding Text}"
                            IsSelected="{Binding IsSelected}"
                            Margin="{StaticResource ChipMargin}"
                            AutomationId="{Binding AutomationId}"
                            Command="{Binding SelectPresetCommand, Source={RelativeSource AncestorType={x:Type vm:NewLetterViewModel}}, x:DataType=vm:NewLetterViewModel}"
                            CommandParameter="{Binding .}" />
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </FlexLayout>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource SpaceS}">
        <Button Text="−"
                Style="{StaticResource StepButton}"
                Command="{Binding DecreaseCommand}"
                SemanticProperties.Description="{x:Static p:Strings.NewLetter_Less}"
                AutomationId="NewLetterDaysMinus" />
        <Label Grid.Column="1"
               Text="{Binding DaysText}"
               Style="{StaticResource TitleLabel}"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               AutomationId="NewLetterDaysLabel" />
        <Button Grid.Column="2"
                Text="+"
                Style="{StaticResource StepButton}"
                Command="{Binding IncreaseCommand}"
                SemanticProperties.Description="{x:Static p:Strings.NewLetter_More}"
                AutomationId="NewLetterDaysPlus" />
        <Button Grid.Column="3"
                Text="{Binding TimeText}"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding PickTimeCommand}"
                SemanticProperties.Description="{x:Static p:Strings.NewLetter_Time}"
                AutomationId="NewLetterTimeButton" />
      </Grid>
      <Label Text="{Binding OpenText}"
             Style="{StaticResource SecondaryLabel}"
             HorizontalTextAlignment="Center"
             AutomationId="NewLetterOpenLabel" />
    </VerticalStackLayout>
  </Grid>
</views:ViewModelPage>
