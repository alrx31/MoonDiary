<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:views="clr-namespace:MoonDiary.Views"
                     xmlns:c="clr-namespace:MoonDiary.Controls"
                     xmlns:p="clr-namespace:MoonDiary.Presentation;assembly=MoonDiary.Presentation"
                     xmlns:vm="clr-namespace:MoonDiary.Presentation.ViewModels;assembly=MoonDiary.Presentation"
                     xmlns:cal="clr-namespace:MoonDiary.Core.Calendar;assembly=MoonDiary.Core"
                     x:Class="MoonDiary.Views.CheckinPage"
                     x:DataType="vm:CheckinViewModel">
  <Grid RowDefinitions="Auto,*" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpaceM}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Text="✕"
              Style="{StaticResource IconButton}"
              Command="{Binding CloseCommand}"
              SemanticProperties.Description="{x:Static p:Strings.Common_Close}"
              AutomationId="CheckinCloseButton" />
      <Label Grid.Column="1" Text="{x:Static p:Strings.Checkin_Title}" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
      <Button Grid.Column="2"
              Text="{x:Static p:Strings.Common_Done}"
              Style="{StaticResource TextButton}"
              Command="{Binding SaveCommand}"
              AutomationId="CheckinDoneButton" />
    </Grid>
    <ScrollView Grid.Row="1">
      <VerticalStackLayout Spacing="{StaticResource SpaceM}">
        <Label Text="{x:Static p:Strings.Common_Energy}" Style="{StaticResource SectionLabel}" HorizontalTextAlignment="Center" />
        <c:MoodScaleView Kind="Energy" Value="{Binding Energy}" IdPrefix="CheckinEnergy" />
        <Label Text="{Binding EnergyLabel}" Style="{StaticResource EnergyLabel}" HorizontalTextAlignment="Center" />
        <Label Text="{x:Static p:Strings.Common_Positivity}" Style="{StaticResource SectionLabel}" HorizontalTextAlignment="Center" />
        <c:MoodScaleView Kind="Positivity" Value="{Binding Positivity}" IdPrefix="CheckinPositivity" />
        <Label Text="{Binding PositivityLabel}" Style="{StaticResource PositivityLabel}" HorizontalTextAlignment="Center" />
        <Label Text="{x:Static p:Strings.Checkin_Question}" Style="{StaticResource SectionLabel}" />
        <Border Style="{StaticResource Card}">
          <VerticalStackLayout>
            <Editor Text="{Binding Text}"
                    Placeholder="{x:Static p:Strings.Checkin_Placeholder}"
                    MaxLength="500"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="96"
                    AutomationId="CheckinTextEditor" />
            <Label Text="{Binding Counter}" Style="{StaticResource SecondaryLabel}" IsVisible="{Binding ShowCounter}" HorizontalTextAlignment="End" />
          </VerticalStackLayout>
        </Border>
        <Button Text="{x:Static p:Strings.Common_Delete}"
                Style="{StaticResource DestructiveButton}"
                IsVisible="{Binding IsEdit}"
                Command="{Binding DeleteCommand}"
                HorizontalOptions="Center"
                AutomationId="CheckinDeleteButton" />
      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</views:ViewModelPage>
