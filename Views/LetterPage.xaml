<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:views="clr-namespace:MoonDiary.Views"
                     xmlns:c="clr-namespace:MoonDiary.Controls"
                     xmlns:p="clr-namespace:MoonDiary.Presentation;assembly=MoonDiary.Presentation"
                     xmlns:vm="clr-namespace:MoonDiary.Presentation.ViewModels;assembly=MoonDiary.Presentation"
                     x:Class="MoonDiary.Views.LetterPage"
                     x:DataType="vm:LetterViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpaceM}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Text="‹"
              Style="{StaticResource IconButton}"
              Command="{Binding BackCommand}"
              SemanticProperties.Description="{x:Static p:Strings.Common_Back}"
              AutomationId="LetterBackButton" />
      <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
    </Grid>
    <ScrollView Grid.Row="1">
      <VerticalStackLayout Spacing="{StaticResource SpaceM}">
        <Label Text="{Binding Written}" Style="{StaticResource SecondaryLabel}" />
        <Border Style="{StaticResource Card}">
          <Label Text="{Binding Text}" AutomationId="LetterText" />
        </Border>
      </VerticalStackLayout>
    </ScrollView>
    <Button Grid.Row="2"
            Text="{x:Static p:Strings.Common_Delete}"
            Style="{StaticResource DestructiveButton}"
            Command="{Binding DeleteCommand}"
            HorizontalOptions="Center"
            AutomationId="LetterDeleteButton" />
  </Grid>
</views:ViewModelPage>
