<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:views="clr-namespace:MoonDiary.Views"
                     xmlns:c="clr-namespace:MoonDiary.Controls"
                     xmlns:p="clr-namespace:MoonDiary.Presentation;assembly=MoonDiary.Presentation"
                     xmlns:vm="clr-namespace:MoonDiary.Presentation.ViewModels;assembly=MoonDiary.Presentation"
                     x:Class="MoonDiary.Views.TagFormPage"
                     x:DataType="vm:TagFormViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpaceM}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Text="✕"
              Style="{StaticResource IconButton}"
              Command="{Binding CloseCommand}"
              SemanticProperties.Description="{x:Static p:Strings.Common_Back}"
              AutomationId="TagFormCloseButton" />
      <Label Grid.Column="1" Text="{x:Static p:Strings.TagForm_Title}" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
    </Grid>
    <ScrollView Grid.Row="1">
      <VerticalStackLayout Spacing="{StaticResource SpaceS}">
        <Label Text="{x:Static p:Strings.TagForm_Label}" Style="{StaticResource SectionLabel}" />
        <Border Style="{StaticResource Card}">
          <Entry Text="{Binding Label}" MaxLength="40" AutomationId="TagFormLabelEntry" />
        </Border>
        <Label Text="{x:Static p:Strings.TagForm_Icon}" Style="{StaticResource SectionLabel}" />
        <Label Text="{Binding Icon}" Style="{StaticResource DisplayLabel}" AutomationId="TagFormIconLabel" />
        <FlexLayout BindableLayout.ItemsSource="{Binding Icons}" Wrap="Wrap">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button Text="{Binding .}"
                      Style="{StaticResource IconButton}"
                      Command="{Binding SelectIconCommand, Source={RelativeSource AncestorType={x:Type vm:TagFormViewModel}}, x:DataType=vm:TagFormViewModel}"
                      CommandParameter="{Binding .}" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </FlexLayout>
        <Label Text="{x:Static p:Strings.TagForm_Direction}" Style="{StaticResource SectionLabel}" />
        <Border Style="{StaticResource Card}">
          <Picker ItemsSource="{Binding Directions}" SelectedIndex="{Binding DirectionIndex}" AutomationId="TagFormDirectionPicker" />
        </Border>
      </VerticalStackLayout>
    </ScrollView>
    <Button Grid.Row="2"
            Text="{x:Static p:Strings.TagForm_Save}"
            Style="{StaticResource PrimaryButton}"
            Command="{Binding SaveCommand}"
            AutomationId="TagFormSaveButton" />
  </Grid>
</views:ViewModelPage>
