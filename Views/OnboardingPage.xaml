<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:views="clr-namespace:MoonDiary.Views"
                     xmlns:c="clr-namespace:MoonDiary.Controls"
                     xmlns:p="clr-namespace:MoonDiary.Presentation;assembly=MoonDiary.Presentation"
                     xmlns:vm="clr-namespace:MoonDiary.Presentation.ViewModels;assembly=MoonDiary.Presentation"
                     x:Class="MoonDiary.Views.OnboardingPage"
                     x:DataType="vm:OnboardingViewModel">
  <Grid RowDefinitions="*,Auto" Padding="{StaticResource PagePadding}">
    <VerticalStackLayout VerticalOptions="Center" Spacing="{StaticResource SpaceL}">
      <Label Text="{x:Static p:Strings.AppName}" Style="{StaticResource DisplayLabel}" HorizontalTextAlignment="Center" AutomationId="OnboardingTitle" />
      <Label Text="{x:Static p:Strings.Onboarding_Text}" HorizontalTextAlignment="Center" />
      <Label Text="{x:Static p:Strings.Onboarding_Question}" Style="{StaticResource SecondaryLabel}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
    <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource SpaceS}">
      <Button Text="{x:Static p:Strings.Onboarding_Allow}" Style="{StaticResource PrimaryButton}" Command="{Binding AllowCommand}" AutomationId="OnboardingAllowButton" />
      <Button Text="{x:Static p:Strings.Onboarding_Later}" Style="{StaticResource TextButton}" Command="{Binding LaterCommand}" AutomationId="OnboardingLaterButton" />
    </VerticalStackLayout>
  </Grid>
</views:ViewModelPage>
