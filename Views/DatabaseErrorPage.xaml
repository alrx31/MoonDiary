<?xml version="1.0" encoding="utf-8" ?>
<views:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:views="clr-namespace:MoonDiary.Views"
                     xmlns:c="clr-namespace:MoonDiary.Controls"
                     xmlns:p="clr-namespace:MoonDiary.Presentation;assembly=MoonDiary.Presentation"
                     xmlns:vm="clr-namespace:MoonDiary.Presentation.ViewModels;assembly=MoonDiary.Presentation"
                     x:Class="MoonDiary.Views.DatabaseErrorPage"
                     x:DataType="vm:DatabaseErrorViewModel">
  <Grid RowDefinitions="*,Auto" Padding="{StaticResource PagePadding}">
    <VerticalStackLayout VerticalOptions="Center" Spacing="{StaticResource SpaceM}">
      <Label Text="{x:Static p:Strings.DatabaseError_Title}" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" AutomationId="DatabaseErrorTitle" />
      <Label Text="{x:Static p:Strings.DatabaseError_Text}" HorizontalTextAlignment="Center" />
      <Label Text="{Binding Details}" Style="{StaticResource SecondaryLabel}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
    <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource SpaceS}">
      <Button Text="{x:Static p:Strings.DatabaseError_Retry}" Style="{StaticResource PrimaryButton}" Command="{Binding RetryCommand}" AutomationId="DatabaseErrorRetryButton" />
      <Button Text="{x:Static p:Strings.DatabaseError_Reset}" Style="{StaticResource DestructiveButton}" Command="{Binding ResetCommand}" AutomationId="DatabaseErrorResetButton" />
    </VerticalStackLayout>
  </Grid>
</views:ViewModelPage>
