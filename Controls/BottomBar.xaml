<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:p="clr-namespace:MoonDiary.Presentation;assembly=MoonDiary.Presentation"
             xmlns:vm="clr-namespace:MoonDiary.Presentation.ViewModels;assembly=MoonDiary.Presentation"
             x:Class="MoonDiary.Controls.BottomBar"
             x:DataType="vm:BottomBarViewModel">
  <Grid RowDefinitions="1,Auto"
        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
    <BoxView Style="{StaticResource Divider}" />
    <Grid Grid.Row="1"
          ColumnDefinitions="*,*,Auto,*,*"
          Padding="{StaticResource BarPadding}">
      <Button x:Name="CalendarTab"
              Grid.Column="0"
              Style="{StaticResource TabButton}"
              Text="{x:Static p:Strings.Tab_Calendar}"
              AutomationId="TabCalendar"
              Command="{Binding GoToCommand}"
              CommandParameter="Calendar" />
      <Button x:Name="AnalyticsTab"
              Grid.Column="1"
              Style="{StaticResource TabButton}"
              Text="{x:Static p:Strings.Tab_Analytics}"
              AutomationId="TabAnalytics"
              Command="{Binding GoToCommand}"
              CommandParameter="Analytics" />
      <Button Grid.Column="2"
              Style="{StaticResource FillButton}"
              Text="+"
              AutomationId="TabFill"
              SemanticProperties.Description="{x:Static p:Strings.Tab_Fill}"
              Command="{Binding FillCommand}" />
      <Button x:Name="LettersTab"
              Grid.Column="3"
              Style="{StaticResource TabButton}"
              Text="{x:Static p:Strings.Tab_Letters}"
              AutomationId="TabLetters"
              Command="{Binding GoToCommand}"
              CommandParameter="Letters" />
      <Button x:Name="UserTab"
              Grid.Column="4"
              Style="{StaticResource TabButton}"
              Text="{x:Static p:Strings.Tab_User}"
              AutomationId="TabUser"
              Command="{Binding GoToCommand}"
              CommandParameter="User" />
    </Grid>
  </Grid>
</ContentView>
